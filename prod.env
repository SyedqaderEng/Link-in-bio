# Production Environment

# PostgreSQL Database (Production)
# Option 1: Supabase PostgreSQL
POSTGRES_HOST=db.xxxxx.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-production-password

# Option 2: External PostgreSQL (AWS RDS, DigitalOcean, etc.)
# POSTGRES_HOST=your-db-host.amazonaws.com
# POSTGRES_PORT=5432
# POSTGRES_DB=linkbio
# POSTGRES_USER=your-db-user
# POSTGRES_PASSWORD=your-secure-password

# Prisma Database URL (Update with your actual connection string)
DATABASE_URL=postgresql://postgres:your-production-password@db.xxxxx.supabase.co:5432/postgres

# App Configuration
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_APP_NAME=LinkBio

# JWT Secret (MUST BE DIFFERENT FROM LOCAL - Generate secure random string)
JWT_SECRET=your-production-jwt-secret-minimum-32-characters-use-openssl-rand

# Stripe (Production keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_key
STRIPE_SECRET_KEY=sk_live_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRO_PRICE_ID=price_live_your_pro_id
STRIPE_LIFETIME_PRICE_ID=price_live_your_lifetime_id

# Email Service (Production)
RESEND_API_KEY=re_your_production_key

# Supabase (If using Supabase for auth/storage)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth Configuration
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=your-nextauth-secret
