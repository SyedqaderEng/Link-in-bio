# Database
DATABASE_URL="postgresql://postgres:your-password@db.xxxxx.supabase.co:5432/postgres"

# NextAuth
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_SECRET="your-production-nextauth-secret-use-openssl-rand"

# App Configuration
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_NAME="LinkBio"

# JWT Secret (MUST BE DIFFERENT FROM LOCAL)
JWT_SECRET="your-production-jwt-secret-minimum-32-characters"

# Stripe (Production keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_your_key"
STRIPE_SECRET_KEY="sk_live_your_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
STRIPE_PRO_PRICE_ID="price_live_your_pro_id"
STRIPE_LIFETIME_PRICE_ID="price_live_your_lifetime_id"

# Email Service (Production)
RESEND_API_KEY="re_your_production_key"

# Supabase (Optional - if using for auth/storage)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
