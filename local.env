# Local Development Environment

# PostgreSQL Database (Local)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=linkbio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Prisma Database URL (constructed from above values)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linkbio

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LinkBio

# JWT Secret for Authentication
JWT_SECRET=local-dev-secret-change-in-production-minimum-32-characters

# Stripe (Optional for local testing - use test keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
STRIPE_PRO_PRICE_ID=price_test_your_id
STRIPE_LIFETIME_PRICE_ID=price_test_your_id

# Email Service (Optional for local testing)
RESEND_API_KEY=re_your_key_here

# Supabase (Not needed for local PostgreSQL setup)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_ANON_KEY=not-used-locally
SUPABASE_SERVICE_ROLE_KEY=not-used-locally
